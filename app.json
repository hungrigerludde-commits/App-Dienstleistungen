{
  "expo": {
    "name": "StadtHelfer",
    "slug": "stadthelfer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.stadthelfer.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "stadthelfer",
    "experiments": {
      "typedRoutes": false
    },
    "platforms": [
      "ios",
      "web"
    ]
  }
}
